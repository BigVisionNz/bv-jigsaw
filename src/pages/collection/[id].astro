---
import { CollectionView } from "@/components/CollectionView"
import Base from "@/layouts/Base.astro"
import { loadPuzzleGroups } from "@/lib/catalog"
import { gallerySlide } from "@/lib/page-slide"

export const prerender = true

export function getStaticPaths() {
  const groups = loadPuzzleGroups()
  const specials = [
    { id: "played", title: "Recently Played" },
    { id: "favourites", title: "Favourites" },
    { id: "mine", title: "My Images" },
    { id: "received", title: "Received Images" },
  ]
  return [
    ...groups.map((group) => ({
      params: { id: group.id },
      props: { title: group.title, groups },
    })),
    ...specials.map((item) => ({
      params: { id: item.id },
      props: { title: item.title, groups },
    })),
  ]
}

const { id } = Astro.params
const { title, groups } = Astro.props
---

<Base title={`${title} · BV Jigsaw`} slide>
  <main transition:name="gallery" transition:animate={gallerySlide} class="min-h-0 flex-1 overflow-y-auto">
    <CollectionView client:load id={id ?? ""} groups={groups} />
  </main>
</Base>
