---
import { loadPuzzleGroups } from "@/lib/catalog"

export const prerender = true

export function getStaticPaths() {
  return loadPuzzleGroups().map((group) => ({
    params: { id: group.id },
  }))
}

const id = Astro.params.id
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting</title>
    <link rel="canonical" href={`/collection/${id}`} />
    <meta http-equiv="refresh" content={`0;url=/collection/${id}`} />
    <script is:inline define:vars={{ id }}>
      location.replace(`/collection/${id}`)
    </script>
  </head>
  <body>
    <a href={`/collection/${id}`}>Continue to the collection</a>
  </body>
</html>
