---
import { PuzzleBoard } from "@/components/PuzzleBoard"
import Base from "@/layouts/Base.astro"
import { loadPuzzle, loadPuzzles } from "@/lib/catalog"

export function getStaticPaths() {
  return loadPuzzles().map((puzzle) => ({ params: { slug: puzzle.slug } }))
}

const puzzle = loadPuzzle(Astro.params.slug)
if (!puzzle) {
  return Astro.redirect("/")
}
---

<Base title={`${puzzle.title} · BV Jigsaw`} picture>
  <main class="flex min-h-0 flex-1 flex-col overflow-hidden">
    <PuzzleBoard client:only="react" puzzle={puzzle} />
  </main>
</Base>
